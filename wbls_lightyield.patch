diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..7dfbf26b7d0d85c7b9a2683f4324abd8c92d4a0d
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,24 @@
+cmake_minimum_required(VERSION 3.16)
+project(WbLSLightYieldToy LANGUAGES CXX)
+
+find_package(Geant4 REQUIRED ui_all vis_all)
+
+file(GLOB sources CONFIGURE_DEPENDS src/src/*.cc src/G4Manager.cc)
+file(GLOB headers CONFIGURE_DEPENDS src/include/*.hh)
+
+add_executable(wblsSim ${sources} ${headers})
+target_include_directories(wblsSim PRIVATE src/include)
+target_link_libraries(wblsSim PRIVATE ${Geant4_LIBRARIES})
+target_compile_features(wblsSim PRIVATE cxx_std_17)
+
+# Copy example macros beside the executable for convenient batch running.
+set(WBLS_MACROS
+  run_Cs137.mac
+  run_Na22.mac
+  run_Co60.mac
+  vis.mac
+)
+foreach(macro ${WBLS_MACROS})
+  configure_file(${CMAKE_CURRENT_SOURCE_DIR}/macros/${macro}
+                 ${CMAKE_CURRENT_BINARY_DIR}/${macro} COPYONLY)
+endforeach()
