+void G4DetectorConstruction::DefineMaterials() {
+  auto* nist = G4NistManager::Instance();
+  nist->FindOrBuildMaterial("G4_AIR");
+  nist->FindOrBuildMaterial("G4_Galactic");
+  nist->FindOrBuildMaterial("G4_SILICON_DIOXIDE");
+  nist->FindOrBuildMaterial("G4_TEFLON");
+
+  auto* water = nist->FindOrBuildMaterial("G4_WATER");
+  auto* wbls = new G4Material("WbLS", water->GetDensity(), water, kStateLiquid);
+  wbls->SetMaterialPropertiesTable(MakeWbLSMPT());
+  wbls->GetIonisation()->SetBirksConstant(fConfig.wblsBirksConstant);
+
+  auto* quartz = G4Material::GetMaterial("G4_SILICON_DIOXIDE");
+  quartz->SetMaterialPropertiesTable(MakeQuartzMPT());
+
+  auto* pmtLarge = new G4Material("LargePhotocathodeVacuum", 1.e-25 * g / cm3, 1, kStateGas);
+  pmtLarge->AddElement(nist->FindOrBuildElement("H"), 1);
+  pmtLarge->SetMaterialPropertiesTable(MakePMTMPT(true));
+  auto* pmtSmall = new G4Material("SmallPhotocathodeVacuum", 1.e-25 * g / cm3, 1, kStateGas);
+  pmtSmall->AddElement(nist->FindOrBuildElement("H"), 1);
+  pmtSmall->SetMaterialPropertiesTable(MakePMTMPT(false));
+}
