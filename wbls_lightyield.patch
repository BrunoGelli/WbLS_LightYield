+++ b/scripts/plot_wbls.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Quick validation plots for the WbLS light-yield toy simulation.
+
+Usage:
+  python3 scripts/plot_wbls.py Cs137_wbls.root --outdir plots
+
+The script uses uproot/matplotlib so it can run outside a ROOT prompt.  It
+expects the `events` and optional `photons` TTrees produced by wblsSim.
+"""
+import argparse
+from pathlib import Path
+
+import matplotlib.pyplot as plt
+import numpy as np
+import uproot
+
+
+def hist(ax, data, title, xlabel, bins=50):
+    ax.hist(np.asarray(data), bins=bins, histtype="stepfilled", alpha=0.75)
+    ax.set_title(title)
+    ax.set_xlabel(xlabel)
+    ax.set_ylabel("Events")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("root_file")
+    parser.add_argument("--outdir", default="plots")
+    args = parser.parse_args()
+
+    outdir = Path(args.outdir)
+    outdir.mkdir(parents=True, exist_ok=True)
+
+    with uproot.open(args.root_file) as f:
+        events = f["events"].arrays(library="np")
+        photons = f["photons"].arrays(library="np") if "photons" in f else None
+
+    fig, axs = plt.subplots(2, 2, figsize=(10, 8))
+    hist(axs[0, 0], events["edepWbLS_keV"], "WbLS energy deposition", "Edep [keV]")
+    hist(axs[0, 1], events["nDetectedLargePMT"], "largePMT detected PE", "PE")
+    hist(axs[1, 0], events["nDetectedSmallPMT"], "smallPMT detected PE", "PE")
+    axs[1, 1].scatter(events["nDetectedLargePMT"], events["nDetectedSmallPMT"], s=10, alpha=0.6)
+    axs[1, 1].set_title("largePMT vs smallPMT")
+    axs[1, 1].set_xlabel("largePMT PE")
+    axs[1, 1].set_ylabel("smallPMT PE")
+    fig.tight_layout()
+    fig.savefig(outdir / "event_summary.png", dpi=160)
+
+    labels = ["large Cer", "small Cer", "large Scint", "small Scint"]
+    values = [
+        events["nDetectedLargePMT_Cerenkov"].sum(),
+        events["nDetectedSmallPMT_Cerenkov"].sum(),
+        events["nDetectedLargePMT_Scintillation"].sum(),
+        events["nDetectedSmallPMT_Scintillation"].sum(),
+    ]
+    fig, ax = plt.subplots(figsize=(8, 5))
+    ax.bar(labels, values)
+    ax.set_ylabel("Detected photons")
+    ax.set_title("Detected scintillation vs Cherenkov totals")
+    fig.tight_layout()
+    fig.savefig(outdir / "detected_process_counts.png", dpi=160)
+
+    if photons is not None and len(photons["wavelength_nm"]):
+        fig, axs = plt.subplots(1, 2, figsize=(11, 4))
+        for pmt_id, name in [(0, "largePMT"), (1, "smallPMT")]:
+            mask = photons["pmtID"] == pmt_id
+            axs[0].hist(photons["wavelength_nm"][mask], bins=60, histtype="step", label=name)
+            axs[1].hist(photons["detectionTime_ns"][mask], bins=60, histtype="step", label=name)
+        axs[0].set_xlabel("Wavelength [nm]")
+        axs[0].set_ylabel("Detected photons")
+        axs[0].set_title("Detected photon wavelengths")
+        axs[1].set_xlabel("Detection time [ns]")
+        axs[1].set_ylabel("Detected photons")
+        axs[1].set_title("Detection times")
+        for ax in axs:
+            ax.legend()
+        fig.tight_layout()
+        fig.savefig(outdir / "detected_photon_spectra_times.png", dpi=160)
+
+
+if __name__ == "__main__":
+    main()
