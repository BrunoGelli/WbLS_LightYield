+void G4PrimaryGeneratorAction::EmitGamma(G4Event* event, G4double energy) {
+  const auto r = fConfig.sourceRadius * std::sqrt(G4UniformRand());
+  const auto phi = CLHEP::twopi * G4UniformRand();
+  const auto zJitter = (G4UniformRand() - 0.5) * fConfig.sourceThickness;
+  const auto sourceZ = fConfig.sphereInnerRadius - fConfig.cuvetteInsertion + fConfig.cuvetteHeight
+                       + fConfig.sourceDistanceAboveSample + zJitter;
+
+  fGun->SetParticleEnergy(energy);
+  fGun->SetParticlePosition({r * std::cos(phi), r * std::sin(phi), sourceZ});
+  fGun->SetParticleMomentumDirection(G4RandomDirection());
+  fGun->GeneratePrimaryVertex(event);
+  fEventAction->RecordPrimary(fIsotope, energy);
 }
 
