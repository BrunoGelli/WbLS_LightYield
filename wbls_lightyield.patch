+  const bool hitSmall = postLV == fDetector->GetSmallPMTLogical();
+  if (!hitLarge && !hitSmall) return;
+
+  const auto qe = QuantumEfficiency(step);
+  if (G4UniformRand() < qe) {
+    const auto* info = dynamic_cast<const PhotonTrackInfo*>(track->GetUserInformation());
+    G4String taggedProcess = info ? info->Process() : "unknown";
+    G4ThreeVector origin = info ? info->Origin() : track->GetVertexPosition();
+    G4int parentID = info ? info->ParentID() : track->GetParentID();
+    G4String creator = "unknown";
+    if (track->GetCreatorProcess()) creator = track->GetCreatorProcess()->GetProcessName();
+    const auto wavelength = CLHEP::h_Planck * CLHEP::c_light / track->GetKineticEnergy();
+    fEventAction->RecordDetection(hitLarge ? 0 : 1, taggedProcess, wavelength,
+                                  track->GetGlobalTime(), parentID, creator, origin,
+                                  postPoint->GetPosition());
+  }
+
+  // A photon crossing into the photocathode either produced a PE or was lost.
+  track->SetTrackStatus(fStopAndKill);
 }
