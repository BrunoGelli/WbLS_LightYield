+std::vector<G4double> EnergiesFromWavelengths(const std::vector<G4double>& wavelengths) {
+  std::vector<G4double> energies;
+  energies.reserve(wavelengths.size());
+  for (auto wl : wavelengths) energies.push_back(CLHEP::h_Planck * CLHEP::c_light / wl);
+  std::reverse(energies.begin(), energies.end()); // Geant4 wants increasing photon energy.
+  return energies;
+}
+
+std::vector<G4double> ReverseCopy(std::vector<G4double> values) {
+  std::reverse(values.begin(), values.end());
+  return values;
+}
+}
