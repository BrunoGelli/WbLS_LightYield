+G4VPhysicalVolume* G4DetectorConstruction::DefineVolumes() {
+  const auto R = fConfig.sphereInnerRadius;
+  const auto worldHalf = R + fConfig.cuvetteHeight + fConfig.sourceDistanceAboveSample + 20.0 * cm;
+
+  auto* air = G4Material::GetMaterial("G4_AIR");
+  auto* spectralon = G4Material::GetMaterial("G4_TEFLON");
+  auto* quartz = G4Material::GetMaterial("G4_SILICON_DIOXIDE");
+  auto* wbls = G4Material::GetMaterial("WbLS");
+  auto* pmtLargeMat = G4Material::GetMaterial("LargePhotocathodeVacuum");
+  auto* pmtSmallMat = G4Material::GetMaterial("SmallPhotocathodeVacuum");
+
+  auto* worldS = new G4Box("World", worldHalf, worldHalf, worldHalf);
+  auto* worldLV = new G4LogicalVolume(worldS, air, "World");
+  auto* worldPV = new G4PVPlacement(nullptr, {}, worldLV, "World", nullptr, false, 0, fCheckOverlaps);
+
+  auto* shellBase = new G4Sphere("SpectralonShellBase", R, R + fConfig.sphereWallThickness,
+                                  0, CLHEP::twopi, 0, CLHEP::pi);
+  auto* sampleCut = new G4Tubs("SamplePortCut", 0, 0.5 * fConfig.samplePortDiameter,
+                               2.0 * fConfig.sphereWallThickness, 0, CLHEP::twopi);
+  auto* shellAfterSample = new G4SubtractionSolid("SpectralonShellMinusSamplePort", shellBase,
+                                                  sampleCut, nullptr, {0, 0, R});
+  auto* pmtCut = new G4Tubs("PMTPortCut", 0, 0.5 * fConfig.largePMTPortDiameter,
+                            2.0 * fConfig.sphereWallThickness, 0, CLHEP::twopi);
+  auto* pmtCutRot = new G4RotationMatrix();
+  pmtCutRot->rotateY(90.0 * deg);
+  auto* shellAfterLarge = new G4SubtractionSolid("SpectralonShellMinusLargePMT", shellAfterSample,
+                                                 pmtCut, pmtCutRot, {R, 0, 0});
+  auto* smallCut = new G4Tubs("SmallPMTPortCut", 0, 0.5 * fConfig.smallPMTPortDiameter,
+                              2.0 * fConfig.sphereWallThickness, 0, CLHEP::twopi);
+  auto* smallCutRot = new G4RotationMatrix();
+  smallCutRot->rotateY(90.0 * deg);
+  auto* shellS = new G4SubtractionSolid("SpectralonShell", shellAfterLarge, smallCut,
+                                        smallCutRot, {-R, 0, 0});
+  auto* shellLV = new G4LogicalVolume(shellS, spectralon, "SpectralonShell");
+  new G4PVPlacement(nullptr, {}, shellLV, "SpectralonShell", worldLV, false, 0, fCheckOverlaps);
+
+  auto* spectralonSurface = new G4OpticalSurface("SpectralonLambertianSurface");
+  spectralonSurface->SetType(dielectric_dielectric);
+  spectralonSurface->SetModel(unified);
+  spectralonSurface->SetFinish(groundfrontpainted);
+  spectralonSurface->SetSigmaAlpha(0.2);
+  spectralonSurface->SetMaterialPropertiesTable(MakeSpectralonMPT());
+  new G4LogicalSkinSurface("SpectralonSkin", shellLV, spectralonSurface);
+
+  const auto cuvetteZ = R - fConfig.cuvetteInsertion + 0.5 * fConfig.cuvetteHeight;
+  auto* cuvetteS = new G4Tubs("QuartzCuvette", 0, fConfig.cuvetteOuterRadius,
+                              0.5 * fConfig.cuvetteHeight, 0, CLHEP::twopi);
+  auto* cuvetteLV = new G4LogicalVolume(cuvetteS, quartz, "QuartzCuvette");
+  new G4PVPlacement(nullptr, {0, 0, cuvetteZ}, cuvetteLV, "QuartzCuvette", worldLV, false, 0,
+                    fCheckOverlaps);
+
+  const auto innerR = std::max(0.1 * mm, fConfig.cuvetteOuterRadius - fConfig.cuvetteWallThickness);
+  const auto innerH = std::max(0.1 * mm, fConfig.cuvetteHeight - 2.0 * fConfig.cuvetteWallThickness);
+  auto* wblsS = new G4Tubs("WbLS", 0, innerR, 0.5 * innerH, 0, CLHEP::twopi);
+  fWbLSLogical = new G4LogicalVolume(wblsS, wbls, "WbLS");
+  new G4PVPlacement(nullptr, {}, fWbLSLogical, "WbLS", cuvetteLV, false, 0, fCheckOverlaps);
+
+  auto* sourceS = new G4Tubs("SourceDisk", 0, fConfig.sourceRadius, 0.5 * fConfig.sourceThickness,
+                             0, CLHEP::twopi);
+  auto* sourceLV = new G4LogicalVolume(sourceS, air, "SourceDisk");
+  const auto sourceZ = R - fConfig.cuvetteInsertion + fConfig.cuvetteHeight
+                       + fConfig.sourceDistanceAboveSample;
+  new G4PVPlacement(nullptr, {0, 0, sourceZ}, sourceLV, "SourceDisk", worldLV, false, 0,
+                    fCheckOverlaps);
+
+  const auto pmtThickness = 0.1 * mm;
+  auto* largeS = new G4Tubs("largePMT", 0, 0.5 * fConfig.largePMTPortDiameter,
+                            0.5 * pmtThickness, 0, CLHEP::twopi);
+  fLargePMTLogical = new G4LogicalVolume(largeS, pmtLargeMat, "largePMT");
+  auto* rotY = new G4RotationMatrix();
+  rotY->rotateY(90.0 * deg);
+  new G4PVPlacement(rotY, {R - 0.5 * pmtThickness, 0, 0}, fLargePMTLogical, "largePMT",
+                    worldLV, false, 0, fCheckOverlaps);
+
+  auto* smallS = new G4Tubs("smallPMT", 0, 0.5 * fConfig.smallPMTPortDiameter,
+                            0.5 * pmtThickness, 0, CLHEP::twopi);
+  fSmallPMTLogical = new G4LogicalVolume(smallS, pmtSmallMat, "smallPMT");
+  auto* rotYSmall = new G4RotationMatrix();
+  rotYSmall->rotateY(90.0 * deg);
+  new G4PVPlacement(rotYSmall, {-R + 0.5 * pmtThickness, 0, 0}, fSmallPMTLogical, "smallPMT",
+                    worldLV, false, 0, fCheckOverlaps);
+
+  shellLV->SetVisAttributes(new G4VisAttributes(G4Colour(0.9, 0.9, 0.9, 0.25)));
+  cuvetteLV->SetVisAttributes(new G4VisAttributes(G4Colour(0.5, 0.8, 1.0, 0.25)));
+  fWbLSLogical->SetVisAttributes(new G4VisAttributes(G4Colour(0.1, 0.4, 1.0, 0.45)));
+  fLargePMTLogical->SetVisAttributes(new G4VisAttributes(G4Colour(0.0, 0.7, 0.0)));
+  fSmallPMTLogical->SetVisAttributes(new G4VisAttributes(G4Colour(0.0, 0.5, 0.0)));
+  sourceLV->SetVisAttributes(new G4VisAttributes(G4Colour(1.0, 0.0, 0.0)));
+
+  return worldPV;
+}
