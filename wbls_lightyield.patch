+  fMessenger->DeclarePropertyWithUnit("ports/sampleDiameter", "cm", fConfig.samplePortDiameter,
+                                      "Top sample-port diameter (documentation/visual guide).") ;
+  fMessenger->DeclarePropertyWithUnit("ports/largePMTDiameter", "cm", fConfig.largePMTPortDiameter,
+                                      "+x large-PMT photocathode/port diameter.");
+  fMessenger->DeclarePropertyWithUnit("ports/smallPMTDiameter", "cm", fConfig.smallPMTPortDiameter,
+                                      "-x small-PMT photocathode/port diameter.");
+  fMessenger->DeclarePropertyWithUnit("cuvette/radius", "cm", fConfig.cuvetteOuterRadius,
+                                      "Outer cuvette radius Rcuvette.");
+  fMessenger->DeclarePropertyWithUnit("cuvette/height", "cm", fConfig.cuvetteHeight,
