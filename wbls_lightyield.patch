+G4MaterialPropertiesTable* G4DetectorConstruction::MakeWbLSMPT() const {
+  // Edit WbLS optical properties here: wavelength grid, refractive index,
+  // absorption length, Rayleigh length, and scintillation spectrum.
+  std::vector<G4double> wl = {250, 300, 350, 400, 450, 500, 550, 600};// nm
+  for (auto& x : wl) x *= nm;
+  auto e = EnergiesFromWavelengths(wl);
+  std::vector<G4double> rindex = ReverseCopy({1.36, 1.35, 1.345, 1.34, 1.337, 1.335, 1.334, 1.333});
+  std::vector<G4double> abs = ReverseCopy({0.05, 0.3, 2.0, 8.0, 12.0, 15.0, 15.0, 15.0});
+  for (auto& x : abs) x *= m * fConfig.wblsAbsLengthScale;
+  std::vector<G4double> rayleigh(e.size(), 30.0 * m);
+  std::vector<G4double> scint = ReverseCopy({0.05, 0.15, 0.55, 1.00, 0.80, 0.35, 0.10, 0.02});
+
+  auto* mpt = new G4MaterialPropertiesTable();
+  mpt->AddProperty("RINDEX", e, rindex);
+  mpt->AddProperty("ABSLENGTH", e, abs);
+  mpt->AddProperty("RAYLEIGH", e, rayleigh);
+  mpt->AddProperty("SCINTILLATIONCOMPONENT1", e, scint);
+  mpt->AddConstProperty("SCINTILLATIONYIELD", fConfig.wblsLightYield);
+  mpt->AddConstProperty("RESOLUTIONSCALE", 1.0);
+  mpt->AddConstProperty("SCINTILLATIONTIMECONSTANT1", fConfig.wblsDecayTime);
+  mpt->AddConstProperty("SCINTILLATIONYIELD1", 1.0);
+  return mpt;
+}
+
+G4MaterialPropertiesTable* G4DetectorConstruction::MakeQuartzMPT() const {
+  // Quartz/borosilicate-like transmission with a UV cutoff near 270 nm.
+  std::vector<G4double> wl = {240, 260, 270, 300, 350, 450, 600, 700};
+  for (auto& x : wl) x *= nm;
+  auto e = EnergiesFromWavelengths(wl);
+  std::vector<G4double> rindex = ReverseCopy({1.58, 1.55, 1.50, 1.48, 1.47, 1.465, 1.46, 1.458});
+  std::vector<G4double> abs = ReverseCopy({0.01, 0.02, 0.10, 5.0, 10.0, 10.0, 10.0, 10.0});
+  for (auto& x : abs) x *= m;
+  auto* mpt = new G4MaterialPropertiesTable();
+  mpt->AddProperty("RINDEX", e, rindex);
+  mpt->AddProperty("ABSLENGTH", e, abs);
+  return mpt;
+}
+
+G4MaterialPropertiesTable* G4DetectorConstruction::MakePMTMPT(G4bool large) const {
+  // Edit PMT QE curves here.  EFFICIENCY is read by SteppingAction for an
+  // explicit Bernoulli detection so hit accounting is transparent.
+  std::vector<G4double> wl = {250, 300, 350, 400, 450, 500, 550, 600, 650};
+  for (auto& x : wl) x *= nm;
+  auto e = EnergiesFromWavelengths(wl);
+  std::vector<G4double> qe = large
+      ? ReverseCopy({0.02, 0.10, 0.22, 0.28, 0.25, 0.18, 0.08, 0.02, 0.00})
+      : ReverseCopy({0.01, 0.08, 0.18, 0.24, 0.22, 0.15, 0.06, 0.01, 0.00});
+  const auto scale = large ? fConfig.largePMTQEScale : fConfig.smallPMTQEScale;
+  for (auto& x : qe) x = std::clamp(x * scale, 0.0, 1.0);
+  std::vector<G4double> rindex(e.size(), 1.0);
+  auto* mpt = new G4MaterialPropertiesTable();
+  mpt->AddProperty("RINDEX", e, rindex);
+  mpt->AddProperty("EFFICIENCY", e, qe);
+  return mpt;
+}
+
+G4MaterialPropertiesTable* G4DetectorConstruction::MakeSpectralonMPT() const {
+  // Edit Spectralon reflectivity vs wavelength here.  This simple constant is a
+  // high-reflectivity Lambertian approximation.
+  std::vector<G4double> wl = {250, 300, 350, 400, 450, 500, 550, 600, 700};
+  for (auto& x : wl) x *= nm;
+  auto e = EnergiesFromWavelengths(wl);
+  std::vector<G4double> reflectivity(e.size(), std::clamp(fConfig.spectralonReflectivity, 0.0, 1.0));
+  auto* mpt = new G4MaterialPropertiesTable();
+  mpt->AddProperty("REFLECTIVITY", e, reflectivity);
+  return mpt;
+}
